<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:elevation="4dp"
    android:padding="0dp">

    <ImageButton
        android:id="@+id/overlayCaptureButton"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/overlay_button_background"
        android:alpha="0.88"
        android:contentDescription="@string/button_save_capture"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_capture"
        android:tint="@android:color/white" />

    <TextView
        android:id="@+id/overlayStatusChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/overlay_status_chip_background"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:maxWidth="180dp"
        android:minHeight="32dp"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp"
        android:textColor="@android:color/white"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>
