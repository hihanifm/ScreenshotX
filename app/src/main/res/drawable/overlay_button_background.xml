<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:endColor="#F00B57D0"
                android:startColor="#F01A73E8"
                android:type="linear" />
            <stroke
                android:width="2.5dp"
                android:color="#CCFFFFFF" />
        </shape>
    </item>

    <item
        android:top="10dp"
        android:left="10dp"
        android:right="10dp">
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:endColor="#00FFFFFF"
                android:startColor="#33FFFFFF"
                android:type="linear" />
        </shape>
    </item>

</layer-list>
