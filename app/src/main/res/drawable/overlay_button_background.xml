<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:endColor="#CC2AB7FF"
                android:startColor="#E64C5DFF"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" />
        </shape>
    </item>

    <item
        android:top="10dp"
        android:left="10dp"
        android:right="10dp">
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:endColor="#00FFFFFF"
                android:startColor="#33FFFFFF"
                android:type="linear" />
        </shape>
    </item>

    <item
        android:left="4dp"
        android:right="4dp"
        android:top="8dp">
        <shape android:shape="oval">
            <solid android:color="#22000000" />
        </shape>
    </item>

</layer-list>

